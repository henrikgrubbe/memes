{
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "format": "oxfmt --write src package.json package-lock.json renovate.json tsconfig.ingress.json tsconfig.json tsconfig.worker.json vitest-browser.d.ts vitest.config.ts .github/workflows",
    "format:check": "oxfmt --check src package.json package-lock.json renovate.json tsconfig.ingress.json tsconfig.json tsconfig.worker.json vitest-browser.d.ts vitest.config.ts .github/workflows",
    "lint": "oxlint --import-plugin -D import/order --deny-warnings src",
    "lint:ci": "npm run lint -- --format=github",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ci": "vitest run --coverage --reporter=default --reporter=github-actions --reporter=junit --outputFile.junit=reports/junit.xml --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html --coverage.reporter=lcovonly",
    "test:watch": "vitest",
    "start:webhook": "tsx src/hosted/ingress/webhook-server.ts",
    "start:worker": "tsx src/hosted/worker/worker-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-sqs": "^3.1126.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "effect": "^3.22.1",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/expect": "^5.0.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
