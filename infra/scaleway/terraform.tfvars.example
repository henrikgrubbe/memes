# Non-secret example only. Copy values into .env.scaleway as TF_VAR_* exports.
project_id           = "00000000-0000-0000-0000-000000000000"
region               = "nl-ams"
name_prefix          = "memes"
github_repository    = "henrikgrubbe/memes"
github_target_branch = "main"

# Principal attached to the API key used by OpenTofu. The setup wizard derives
# this from SCW_ACCESS_KEY when possible.
object_storage_provisioning_principal = "user_id:00000000-0000-0000-0000-000000000000"

# Optional override. The default includes the project ID and is globally unique.
# object_storage_bucket_name = "memes-example-images"

# Safe deployment defaults:
deploy_containers      = false
worker_trigger_enabled = false
hosted_ingress_mode    = "off"
worker_mode            = "diagnostic"
